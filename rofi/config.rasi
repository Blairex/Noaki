

// Config //
configuration {
    modi:                        "drun,filebrowser,window,run";
    show-icons:                  true;
    display-drun:                " ";
    drun-display-format:         "{name}";
    font:                        "JetBrainsMono Nerd Font 10";
    icon-theme:                  "Tela-circle-dracula";
}

@theme "~/.config/rofi/theme.rasi"


// Main Window //
window {
    width:                       20em; 
    transparency:                "real";
    enabled:                     true;
    cursor:                      "default";
    background-color:            @main-bg;
    border-radius:               10px;
    border:                      1px;
    border-color:                @main-br;
}

mainbox {
    enabled:                     true;
    spacing:                     0em;
    padding:                     0em;
    orientation:                 vertical;
    children:                    [ "inputbar", "listview" ];
    background-color:            transparent;
}

// Search Bar //
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     8px 12px;
    background-color:            @main-bg;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @main-fg;
    font:                        "JetBrainsMono Nerd Font 9"; 
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @main-fg;
    placeholder:                 "Search";
    placeholder-color:           #6c7086;
    vertical-align:              0.5;
}

// List of Apps //
listview {
    enabled:                     true;
    padding:                     6px;   
    columns:                     1;
    lines:                       5;        
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;    
    background-color:            transparent;
    spacing:                     2px;
}

// Individual Element //
element {
    enabled:                     true;
    spacing:                     12px;
    padding:                     4px 8px;
    border-radius:               6px;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @main-fg;
}

element selected.normal {
    background-color:            @select-bg;
    text-color:                  @select-fg;
}

element-icon {
    size:                        22px;  
    cursor:                      inherit;
    background-color:            transparent;
}

element-text {
    vertical-align:              0.5;
    horizontal-align:            0.0;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}
